{
  "compilerOptions": {
    "outDir": "./dist/",
    "baseUrl": ".",
    "paths": {
      "@ifc_viewer/assets/*": ["public/assets/*"],
      "@ifc_viewer/components/*": ["src/components/*"],
      "@ifc_viewer/models/*": ["src/models/*"],
      "@ifc_viewer/store/*": ["src/store/*"],
      "@ifc_viewer/helpers/*": ["src/helpers/*"],
      "@ifc_viewer/index": ["src/index.tsx"]
    },
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2017",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node"
  }
}