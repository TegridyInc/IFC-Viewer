{
  "compilerOptions": {
    "outDir": "./dist/",
    "baseUrl": ".",
    "paths": {
      "@pim_platform/assets/*": ["public/assets/*"],
      "@pim_platform/components/*": ["src/components/*"],
      "@pim_platform/models/*": ["src/models/*"],
      "@pim_platform/store/*": ["src/store/*"],
      "@pim_platform/helpers/*": ["src/helpers/*"]
    },
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2017",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "node"
  }
}